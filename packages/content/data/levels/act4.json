  {
    "id": "4-1",
    "index": 1,
    "title": "Read Replicas",
    "from": "Raj, NimbusCart investor",
    "brief": "We're at 200,000 customers and browsing has exploded: people check product pages ten times for every order. The database is pinned at 100% every evening. Upgrading it to the next size is eye-wateringly expensive. Is there a smarter way?",
    "lesson": "Read replicas are copies of the database that serve reads. Most traffic is reads, so a couple of replicas can take most of the load off the primary for less than one huge instance.",
    "budget": 400,
    "traffic": {
      "peakRps": 600,

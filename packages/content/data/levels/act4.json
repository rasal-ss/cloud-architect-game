        "type": "noSecurityIssues"
      }
    ],
    "palette": ["ec2", "s3", "cloudfront", "rds", "alb", "asg", "rds_replica", "elasticache"],
    "startingDesign": {
      "nodes": [
        {
          "id": "users",
          "kind": "users",
          "x": 0,
          "y": 220,
          "config": {},
          "label": "Customers",

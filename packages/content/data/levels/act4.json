        "atMinute": 540,
        "multiplier": 4,
        "rampMinutes": 5,
        "holdMinutes": 120,
        "warning": true,
        "title": "Black Friday sale opens",
        "lesson": "Known events deserve preparation: extra capacity and pre-warmed caches before the doors open."
      },
      {
        "id": "flush",
        "type": "cache_flush",
        "atMinute": 540,
        "warning": true,
        "title": "Homepage deploy empties the cache",
        "lesson": "Deploys and restarts empty caches. Plan for a cold cache at the worst moment."
      }

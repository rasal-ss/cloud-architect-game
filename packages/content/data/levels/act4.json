  {
    "id": "4-5",
    "index": 5,
    "boss": true,
    "title": "Boss: Black Friday with a Cold Cache",
    "from": "Maya, founder of NimbusCart",
    "brief": "Black Friday. The sale opens at 9:00 and we deploy the new homepage at exactly the same moment, which empties every cache. Expect four times normal traffic hitting a cold cache. Product data can be up to 5 minutes old. Do not let the database melt.",
    "lesson": "A cold cache sends every read to the database at once (a stampede). Size the database tier for misses during warm-up, not just for steady-state hit ratios, and put replicas behind the cache.",
    "budget": 980,
    "traffic": {
      "peakRps": 800,
      "curve": [
        [0, 0.15],
        [3, 0.08],
        [6, 0.2],
        [9, 0.5],
